# Database (Supabase connection string, or any Postgres 15+ instance)
DATABASE_URL="postgresql://user:password@localhost:5432/cobroflow?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-string"

# Email (SendGrid)
SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxxxx"
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"
SENDGRID_FROM_NAME="CobroFlow"

# App
APP_URL="http://localhost:3000"

# Cron job auth (protects the daily reminder endpoint from public calls)
CRON_SECRET="replace-with-a-long-random-string"
